# .env.example  —  한국투자증권(KIS) Open API 자격증명
#
# 이 파일을 복사해 .env 로 만들고 값을 채운다.
#   PowerShell:  Copy-Item .env.example .env
#
# 주의
#   - 파일 이름은 정확히  .env  다. .env.txt 가 되지 않게 한다.
#     (메모장 저장 시 "파일 형식"을 "모든 파일"로 바꾼다)
#   - 저장소 루트(k-stock-agent\)에 둔다.
#   - UTF-8로 저장한다. PowerShell 5.1의 Out-File 은 UTF-16으로
#     저장하므로 쓰지 않는다.
#   - 값에 따옴표나 앞뒤 공백을 넣지 않는다.
#   - .env 는 .gitignore 에 있으므로 커밋되지 않는다.
#
# 값이 맞는지 확인:  python tools\doctor_env.py


# KIS HTS 사용자 ID
# 관심종목 그룹/종목 조회에 사용한다. 계좌번호가 아니라 KIS Developers/HTS 로그인 ID다.
# 이전 설정의 KIS_HTS_USER_ID, KIS_USER_ID 등도 호환용으로 읽는다.
KIS_HTS_ID=


# 운영 범위
#   - 사람 사용자는 OWNER 1명이다.
#   - PAPER는 PAPER_PRIMARY 한 계좌, LIVE는 LIVE_PRIMARY 한 계좌만 사용한다.
#   - 아래 실제 계좌번호는 각 논리 계좌에 1:1로 바인딩된다.
#   - 실행 중 계좌 선택/전환 기능은 없다.
#
# ===============================================================
#  모의투자 — 0단계에서 쓰는 것
# ===============================================================
# KIS 개발자센터 > 모의투자 신청 후 발급받은 앱키/시크릿
KIS_PAPER_APP_KEY=
KIS_PAPER_APP_SECRET=

# 모의투자 계좌번호.
#   KIS Developers > 로그인 > 마이페이지(신청정보) > 신청현황 표에서
#   위 앱키와 나란히 표시된 계좌번호를 쓴다.
#   한국투자 홈페이지·MTS의 모의투자 메뉴에서도 확인할 수 있다.
#
#   종합계좌 8자리 + 상품코드 2자리 구조다.  예) 50012345-01
#   아래처럼 나눠 적는 것이 표준이지만,
#   ACCOUNT 한 칸에 50012345-01 을 통째로 넣어도 시스템이 나눠 읽는다.
KIS_PAPER_ACCOUNT=

# 계좌번호 뒤 2자리(상품코드). 국내주식 위탁계좌는 보통 01.
KIS_PAPER_ACCOUNT_PRODUCT=01


# ===============================================================
#  실전 — 0단계가 끝날 때까지 비워 둔다
# ===============================================================
# 모의투자와 실전은 앱키가 다르다. 섞이지 않도록 이름을 나눠 둔다.
KIS_LIVE_APP_KEY=
KIS_LIVE_APP_SECRET=
KIS_LIVE_ACCOUNT=
KIS_LIVE_ACCOUNT_PRODUCT=01

# 실전 허용 플래그.
# 이것만으로는 실전이 켜지지 않는다. 다음 셋이 모두 필요하다.
#   1. config/broker_environment.yaml 의 environment: LIVE
#   2. 아래 KIS_ALLOW_LIVE=1
#   3. 실행 시 대화형 확인
# KIS_ALLOW_LIVE=1
